# Campus Event Registration & Attendance Prototype Environment Configuration
# Copy or bootstrap via `python scripts/init_runtime.py` into `runtime/secrets.env`

APP_ENV=prototype
TZ_OFFSET_HOURS=8

# Service HTTPS Ports & URLs
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8440
STUDENT_DIRECTORY_URL=https://127.0.0.1:8441
EVENT_REGISTRATION_URL=https://127.0.0.1:8442
ATTENDANCE_SERVICE_URL=https://127.0.0.1:8443
NOTIFICATION_SERVICE_URL=https://127.0.0.1:8444

# Local TLS Certificates (generated by scripts/init_runtime.py)
TLS_CA_CERT_PATH=runtime/certs/ca.crt
TLS_SERVER_CERT_PATH=runtime/certs/server.crt
TLS_SERVER_KEY_PATH=runtime/certs/server.key

# SQLite Database Paths (strictly isolated per component)
STUDENT_DIRECTORY_DB=data/student_directory.db
EVENT_REGISTRATION_DB=data/event_registration.db
ATTENDANCE_DB=data/attendance.db
NOTIFICATION_DB=data/notification.db
GATEWAY_AUTH_DB=data/gateway_auth.db

# Proposal Section 5 Timeout & Retry Configuration (seconds)
INTERNAL_ELIGIBILITY_TIMEOUT_SEC=2.0
INTERNAL_VALIDATE_TIMEOUT_SEC=2.0
REGISTRATION_DEADLINE_SEC=5.0
CHECKIN_DEADLINE_SEC=5.0
CLIENT_WAIT_TIMEOUT_SEC=8.0
REPORTING_DEADLINE_SEC=10.0
NOTIFICATION_TIMEOUT_SEC=3.0
RETRY_MAX_ATTEMPTS=2
RETRY_DELAYS_SEC=1.0,2.0
AUDIT_RETENTION_DAYS=30

# Secrets (REPLACE via scripts/init_runtime.py; never commit real values)
GATEWAY_SERVICE_SECRET=replace-me-gateway-secret
EVENT_REGISTRATION_SERVICE_SECRET=replace-me-registration-secret
ATTENDANCE_SERVICE_SECRET=replace-me-attendance-secret
TOKEN_HMAC_KEY=replace-me-token-hmac-key
TOKEN_FERNET_KEY=replace-me-fernet-base64-key
CONTEXT_HMAC_KEY=replace-me-context-hmac-key
SESSION_SECRET=replace-me-session-secret
