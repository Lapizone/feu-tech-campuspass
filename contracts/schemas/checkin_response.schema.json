{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckInResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["registrationId", "attendanceStatus", "checkInTime"],
  "properties": {
    "registrationId": { "type": "string", "minLength": 1 },
    "attendanceStatus": { "type": "string", "enum": ["CHECKED_IN"] },
    "checkInTime": { "type": "string", "minLength": 1 }
  }
}
